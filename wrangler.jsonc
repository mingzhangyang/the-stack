{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-stack",
  "compatibility_date": "2026-08-06",
  // Static-asset-only Worker: the game is entirely client-side, so there is no
  // `main` entrypoint and no Worker invocation on a request. Cloudflare serves
  // ./dist straight from the edge.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
